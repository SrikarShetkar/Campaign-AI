# CampaignMind AI Backend Environment Configuration
PROJECT_NAME="CampaignMind AI Enterprise"
ENV="development"
PORT=8000
HOST="0.0.0.0"

# OpenAI / LLM Configuration
OPENAI_API_KEY="your-openai-api-key-here"
LLM_MODEL="gpt-4o"
EMBEDDING_MODEL="text-embedding-3-small"

# Vector Store Path
VECTOR_STORE_DIR="app/knowledge_base/vector_index"

# Security & CORS
JWT_SECRET_KEY="campaignmind-super-secret-enterprise-jwt-key-2026"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
